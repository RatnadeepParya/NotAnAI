<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Sign In — Not an AI' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
  <div class="auth-card card">
    <div class="auth-header">
      <div class="logo-icon mb-2" style="font-size: 32px;">⚡</div>
      <h2>Not an AI</h2>
      <p class="text-muted">Sign in to your account</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger mb-3"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/login" class="auth-form">
      <div class="form-group mb-3">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" class="form-control" required placeholder="admin@notanai.local" autofocus>
      </div>

      <div class="form-group mb-4">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required placeholder="••••••••">
      </div>

      <button type="submit" class="btn btn-primary btn-block mb-3">Sign In</button>
      <div class="auth-footer text-center">
        <span class="text-muted">Don't have an account?</span>
        <a href="/auth/register">Create Account</a>
        <div class="mt-3">
          <a href="/" class="text-muted text-sm">Continue as Guest</a>
        </div>
      </div>
    </form>
  </div>
</body>
</html>
