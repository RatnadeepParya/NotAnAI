<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Create Account — Not an AI' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
  <div class="auth-card card">
    <div class="auth-header">
      <div class="logo-icon mb-2" style="font-size: 32px;">⚡</div>
      <h2>Not an AI</h2>
      <p class="text-muted">Create a new local account</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger mb-3"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/register" class="auth-form">
      <div class="form-group mb-3">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" required placeholder="janedoe" autofocus>
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" class="form-control" required placeholder="jane@example.com">
      </div>

      <div class="form-group mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required placeholder="••••••••">
      </div>

      <div class="form-group mb-4">
        <label class="form-label">Administrator Setup Token (Optional)</label>
        <input type="password" name="adminToken" class="form-control" placeholder="Required only for Admin role">
      </div>

      <button type="submit" class="btn btn-primary btn-block mb-3">Create Account</button>
      <div class="auth-footer text-center">
        <span class="text-muted">Already registered?</span>
        <a href="/auth/login">Sign In</a>
      </div>
    </form>
  </div>
</body>
</html>
