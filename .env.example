# ===================================================
# Not an AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# ===================================================

# Server Settings
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
SESSION_SECRET=
COOKIE_SECURE=false

# Firebase Web Client Configuration (Fill in your own credentials)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Optional: path to serviceAccountKey.json if available locally)
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Local Storage and Index Directories
DATA_DIR=./data
INDEXES_DIR=./data/indexes
CACHE_DIR=./data/cache
SNAPSHOTS_DIR=./data/snapshots
IMPORTS_DIR=./data/imports

# Engine & Search Parameters
DEFAULT_BM25_K1=1.5
DEFAULT_BM25_B=0.75
MAX_SEARCH_RESULTS=10
MIN_CONFIDENCE_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.75
LRU_CACHE_CAPACITY=1000

# Administrator Initial Setup Token (Optional)
ADMIN_SETUP_TOKEN=

# Google Search for Web RAG (Optional: for Google Programmable Search)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
